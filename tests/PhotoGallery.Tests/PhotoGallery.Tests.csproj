<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- Run the test exe in Microsoft.Testing.Platform mode too, so extensions such as code coverage are available. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.TestUtilities" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PhotoGallery.Core\PhotoGallery.Core.csproj" />
    <ProjectReference Include="..\..\src\PhotoGallery.Upload\PhotoGallery.Upload.csproj" />
    <ProjectReference Include="..\..\src\PhotoGallery.Processing\PhotoGallery.Processing.csproj" />
    <ProjectReference Include="..\..\src\PhotoGallery.Photos\PhotoGallery.Photos.csproj" />
  </ItemGroup>

</Project>
