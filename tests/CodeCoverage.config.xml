<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage settings (Microsoft.Testing.Extensions.CodeCoverage): measure only hand-written code. -->
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*PhotoGallery\.(Core|Upload|Processing|Photos)\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <!-- Source-generated System.Text.Json metadata, regex and other generator output. -->
        <Source>.*\.g\.cs$</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
